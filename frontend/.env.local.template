# by default; only the exact value "false" removes the feature from the build. Next.js bakes NEXT_PUBLIC_ values into
# the build, so restart `npm run dev` or rebuild after changing it. Set it the
# same way as MATCHING_SUGGESTIONS_ENABLED in backend/.env.
