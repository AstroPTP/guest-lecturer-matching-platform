# Frontend environment. Copy to .env.local and fill in.
#
# .env.local is gitignored; this file is not.
#
# Note which variables are NEXT_PUBLIC_ and which are not. Anything with that
# prefix is compiled into the browser bundle. AUTH0_DOMAIN and AUTH0_AUDIENCE
# deliberately do NOT have it — the token endpoint is called from a route
# handler on the server, never from the browser.

# --- Auth0 (server-side only) ---
# Bare host, no scheme, no trailing slash — same rule as the backend.
#
# Defaults to the local dev identity provider so a fresh clone can sign in with
# no Auth0 account:
#   node tools/dev-idp/server.js
# Swapping to the real tenant is this one variable.
AUTH0_DOMAIN=127.0.0.1:9099
AUTH0_AUDIENCE=https://api.glma.curtin.edu.au

# --- Backend ---
# Where the route handler at /api/backend forwards to. Server-side; the browser
# never calls the API directly, so this is not NEXT_PUBLIC_.
BACKEND_URL=http://localhost:3001

# --- Development sign-in ---
# Exposes /dev_login, which issues a signed token for a test account without
# checking a password. An authentication bypass wherever it is reachable, so it
# is off by default and is ignored entirely when NODE_ENV=production.
NEXT_PUBLIC_DEV_LOGIN=true

# --- Route protection ---
# When true, the proxy redirects unauthenticated users away from
# /guest_lecturer/* and /unit_coordinator/* to /login.
#
# Ships false so pulling this branch does not break the client demo before test
# accounts exist. Set true once you can sign in.
NEXT_PUBLIC_AUTH_ENFORCED=false
