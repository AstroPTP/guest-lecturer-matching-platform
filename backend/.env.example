# Backend environment file, consumed by the NestJS application.
#
# Copy to backend/.env and fill in. Never commit the filled-in file.
#
# src/config/load-env.ts reads that file at the top of bootstrap(), so the
# values below reach the application whichever way it is started: nest start,
# nest start --watch, or node dist/src/main. Anything already set in the real
# environment wins, so CI and the deployed host keep using their own values and
# a missing file is not an error.
#
# Every variable here is required: src/config/env.validation.ts refuses to
# start the process if one is missing or malformed. That is deliberate. A
# backend that boots without AUTH0_DOMAIN and then 401s every request is far
# harder to diagnose than one that will not boot at all.

# --- Server ---
# 3001 because the Next.js frontend owns 3000.
PORT=3001
NODE_ENV=development

# Number of reverse proxies in front of the app. Leave at 0 locally.
#
# Set this to the real hop count when we deploy, NEVER to `true`. Express
# with `trust proxy: true` believes the whole X-Forwarded-For chain, which
# lets a client spoof its own address and reset its rate-limit counter. With
# a count, only that many trusted hops are honoured.
TRUST_PROXY_HOPS=0

# --- CORS ---
# Exact frontend origin, scheme included, no trailing slash.
# Comma-separate for multiple. There is no wildcard fallback.
FRONTEND_URL=http://localhost:3000

# --- Auth0 ---
# Tenant domain, BARE. No https://, no trailing slash. The dashboard shows it
# this way. The issuer and JWKS URI are derived from it, so this is the only
# value to get right.
#
# Our tenant is:
#   AUTH0_DOMAIN=glmp-curtin-dev.au.auth0.com
#
# For local development with no Auth0 account, point it at the dev IdP instead:
#   AUTH0_DOMAIN=127.0.0.1:9099
# and run `node tools/dev-idp/server.js`. Everything below works unchanged.
# This line is the only difference between the two, which is the whole point.
#
# It must be 127.0.0.1, not localhost. The dev IdP binds the loopback address
# and issues tokens whose `iss` claim says 127.0.0.1, and the issuer is
# compared as an exact string, so "localhost" would 401 every request.
AUTH0_DOMAIN=glmp-curtin-dev.au.auth0.com

# The API identifier from Auth0 > Applications > APIs. Compared against the
# token's `aud` claim, so it must match exactly, character for character.
#
# This is the identifier our tenant actually has. It was previously written
# here as https://api.glma.curtin.edu.au, which exists nowhere, so every real
# token would have been rejected with a 401 that looks like a broken guard.
# Found by opening the dashboard on 24 August 2026. No specification document
# names an audience value, so the tenant is the authority.
#
# The dev IdP mints this same audience, so switching between the two really is
# AUTH0_DOMAIN and nothing else.
AUTH0_AUDIENCE=https://glmp-api.curtin.edu.au

# Namespaced roles claim. Auth0 silently drops
# custom claims that are not URIs, so the namespace is not decoration.
# Only set this if you are pointing at something other than our tenant.
AUTH0_ROLES_CLAIM=https://glmp.curtin.edu.au/roles

# MANAGEMENT: a Machine to Machine application authorised for the Auth0
# Management API (Auth0 > Applications > APIs > Auth0 Management API >
# Machine to Machine Applications). The backend swaps these for a Management
# API token with the client_credentials grant. Grant only the scopes the
# settings routes use: read:users, update:users, delete:users, create:users.
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=

# SETTINGS: a separate Regular Web Application with the Password grant
# enabled (Advanced Settings > Grant Types). It's used only to check the
# user's current password before a sensitive change, using the password-realm
# grant. It's kept separate so the Management client never gets the password
# grant, and so this one never gets Management API access.
AUTH0_SETTINGS_CLIENT_ID=
AUTH0_SETTINGS_CLIENT_SECRET=

# --- Database (Prisma) ---
# DATABASE_URL is the pooled connection used at runtime; DIRECT_URL is the
# direct connection used for migrations and is already read by prisma.config.ts.
# remember that, if using special characters (!,#,$ ect.) that they must be URL Percent Encoded to be read
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.kbuadjlbkwniadlxrssf:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.kbuadjlbkwniadlxrssf:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# --- Demo mode, temporary ---
# Attaches a simulated signed-in user so the application can be tested before
# the login flow is wired. Off unless exactly "true", and ignored entirely when
# NODE_ENV=production. Delete this section once login works.
DEMO_AUTH_BYPASS=false
# guest_speaker | unit_coordinator | ccae_admin. Unknown values fall back to
# unit_coordinator rather than granting anything.
DEMO_AUTH_ROLE=unit_coordinator

# --- System health and security thresholds ---
# All optional, and none are checked at boot. Each is read when the
# administrator's system page loads. Unset, non-numeric or non-positive values
# fall back to the default shown. The lines are commented out; uncomment to change.

# Database round trip, in milliseconds, at or above which the database check warns.
# DB_LATENCY_WARN_MS=500
# Size limit of the database plan in megabytes. Leave unset to show size without a percentage.
# DB_SIZE_LIMIT_MB=
# Percent of the database or disk limit at which the storage checks warn.
# STORAGE_WARN_PCT=80
# Percent at which the storage checks warn in critical wording.
# STORAGE_CRITICAL_PCT=90
# Directory whose disk is measured, and shown to administrators. Unset: the API's working directory is measured and shown only as "application directory".
# SYSTEM_DISK_PATH=
# Percent of host memory in use at or above which the memory check warns.
# MEMORY_WARN_PCT=85
# One-minute load average per CPU core above which the CPU check warns.
# CPU_LOAD_WARN=1.5
# Server errors in the last 15 minutes at or above which the error check warns.
# ERROR_RATE_WARN=5
# Days since the last completed, non-dry-run retention.purge entry above which the retention check warns. A failed last run warns regardless.
# RETENTION_ALERT_DAYS=8
# Unauthenticated (401) responses in 15 minutes at or above which a security alert is raised.
# AUTH_FAILURE_WARN=20
# Refused (403) requests to /admin routes in 15 minutes at or above which a security alert is raised.
# ADMIN_FORBIDDEN_WARN=3
