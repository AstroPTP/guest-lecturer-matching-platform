{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(jose)/)"
  ],
  "moduleNameMapper": {
    "^(\\.{1,2}/)+prisma$": "<rootDir>/../src/testing/prisma.double.ts"
  }
}
