# Root environment file, read by docker-compose.yml only.
#
# Copy to .env and adjust. Never commit the filled-in .env; .gitignore already
# excludes it. Every value has a default, so for a standard install you only
# need this file if you want to change a port or use the local database.
#
# Each application has its own file as well — see SETUP.md:
#   backend/.env, frontend/.env.local, frontend/admin/.env.local

# --- Published ports on the host ---
# Address the two websites listen on. 0.0.0.0 = every network interface.
# Set 127.0.0.1 when a reverse proxy (nginx, Caddy, IIS, ...) on this same
# machine terminates HTTPS and forwards to these ports.
BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=3000
ADMIN_PORT=3002
# The API is always published on 127.0.0.1 only.
BACKEND_PORT=3001

# --- Build options ---
# Hard off for the "Suggested speakers" menu item. Baked into the frontend
# build: run `docker compose up -d --build frontend` after changing it. Keep it
# the same as MATCHING_SUGGESTIONS_ENABLED in backend/.env.
NEXT_PUBLIC_MATCHING_SUGGESTIONS=true

# --- Optional local PostgreSQL (only with `--profile local-db`) ---
DB_USER=glma_local
DB_PASSWORD=replace_me
DB_NAME=glma
DB_PORT=5432

# pgAdmin, http://127.0.0.1:5050 (only with `--profile local-db`)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=replace_me
PGADMIN_PORT=5050
