# Root environment file — consumed by docker-compose.yml only.
#
# Copy to .env and fill in. Never commit the filled-in .env; .gitignore
# already excludes it. Placeholders only in this file.
#
# The backend application reads a separate file — see backend/.env.example.

# --- Local PostgreSQL container (docker-compose.yml service "db") ---
DB_USER=glma_local
DB_PASSWORD=replace_me
DB_NAME=glma

# --- pgAdmin container (docker-compose.yml service "pgadmin", http://localhost:5050) ---
PGADMIN_EMAIL=you@student.curtin.edu.au
PGADMIN_PASSWORD=replace_me
